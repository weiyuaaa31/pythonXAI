import turtle
import time
import random

delay = 0.1
score = 0
high_score = 0

# 設定遊戲視窗
wn = turtle.Screen()
wn.title("Python 經典貪食蛇")
wn.bgcolor("black")
wn.setup(width=600, height=600)
wn.tracer(0)  # 關閉自動更新以提升流暢度

# 蛇頭
head = turtle.Turtle()
head.speed(0)
head.shape("square")
head.color("lime")
head.penup()
head.goto(0, 0)
head.direction = "stop"

# 食物
food = turtle.Turtle()
food.speed(0)
food.shape("circle")
food.color("red")
food.penup()
food.goto(0, 100)

segments = []

# 計分板
pen = turtle.Turtle()
pen.speed(0)
pen.shape("square")
pen.color("white")
pen.penup()
pen.hideturtle()
pen.goto(0, 260)
pen.write("得分: 0  最高紀錄: 0", align="center", font=("Courier", 18, "normal"))

# 移動控制函數
def go_up():
    if head.direction != "down":
        head.direction = "up"

def go_down():
    if head.direction != "up":
        head.direction = "down"

def go_left():
    if head.direction != "right":
        head.direction = "left"

def go_right():
    if head.direction != "left":
        head.direction = "right"

def move():
    if head.direction == "up":
        y = head.ycor()
        head.sety(y + 20)
    if head.direction == "down":
        y = head.ycor()
        head.sety(y - 20)
    if head.direction == "left":
        x = head.xcor()
        head.setx(x - 20)
    if head.direction == "right":
        x = head.xcor()
        head.setx(x + 20)

# 鍵盤綁定 (使用 W/A/S/D 或 上下左右 方向鍵)
wn.listen()
wn.onkeypress(go_up, "w")
wn.onkeypress(go_down, "s")
wn.onkeypress(go_left, "a")
wn.onkeypress(go_right, "d")
wn.onkeypress(go_up, "Up")
wn.onkeypress(go_down, "Down")
wn.onkeypress(go_left, "Left")
wn.onkeypress(go_right, "Right")

# 主遊戲迴圈
while True:
    wn.update()

    # 檢測撞牆
    if head.xcor() > 290 or head.xcor() < -290 or head.ycor() > 290 or head.ycor() < -290:
        time.sleep(1)
        head.goto(0, 0)
        head.direction = "stop"

        # 清除蛇身
        for segment in segments:
            segment.goto(1000, 1000)
        segments.clear()

        # 重置分數
        score = 0
        delay = 0.1
        pen.clear()
        pen.write(f"得分: {score}  最高紀錄: {high_score}", align="center", font=("Courier", 18, "normal"))

    # 檢測吃食物
    if head.distance(food) < 20:
        # 食物隨機移位
        x = random.randint(-14, 14) * 20
        y = random.randint(-14, 14) * 20
        food.goto(x, y)

        # 增加蛇身
        new_segment = turtle.Turtle()
        new_segment.speed(0)
        new_segment.shape("square")
        new_segment.color("darkgreen")
        new_segment.penup()
        segments.append(new_segment)

        # 加速與計分
        delay = max(0.03, delay - 0.002) # 越吃移動越快
        score += 10
        if score > high_score:
            high_score = score

        pen.clear()
        pen.write(f"得分: {score}  最高紀錄: {high_score}", align="center", font=("Courier", 18, "normal"))

    # 移動蛇身 (從最後一節跟隨前一節)
    for index in range(len(segments) - 1, 0, -1):
        x = segments[index - 1].xcor()
        y = segments[index - 1].ycor()
        segments[index].goto(x, y)

    if len(segments) > 0:
        x = head.xcor()
        y = head.ycor()
        segments[0].goto(x, y)

    move()

    # 檢測撞到身體
    for segment in segments:
        if segment.distance(head) < 20:
            time.sleep(1)
            head.goto(0, 0)
            head.direction = "stop"

            for seg in segments:
                seg.goto(1000, 1000)
            segments.clear()

            score = 0
            delay = 0.1
            pen.clear()
            pen.write(f"得分: {score}  最高紀錄: {high_score}", align="center", font=("Courier", 18, "normal"))

    time.sleep(delay)

    